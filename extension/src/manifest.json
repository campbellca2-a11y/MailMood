{
  "manifest_version": 3,
  "name": "MailMood | Email Tone Identifier & Rewriter",
  "version": "1.0.2",
  "description": "See email tone at a glance. MailMood adds mood badges to your Gmail inbox—understand message intent before you open it.",
  "short_name": "MailMood - Email Tone",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*"
  ],
  "action": {
    "default_title": "MailMood - Understand Email Tone"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content/index.js"]
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "homepage_url": "https://github.com/campbellca2-a11y/MailMood"
}
