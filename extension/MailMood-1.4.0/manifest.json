{
  "manifest_version": 3,
  "name": "MailMood",
  "version": "1.3.0",
  "permissions": ["storage"],
  "host_permissions": [
    "https://mail.google.com/*"
  ],
  "action": {
    "default_popup": "options.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["dist/content/index.js"]
    }
  ]
}